# vim: filetype=muttrc

set realname = "Yara"

set imap_user = `pass mail/imap_user`
set imap_pass = `pass mail/login.mailbox.org | head -n 1`

set smtp_url = "smtps://smtp.mailbox.org"
set smtp_url = `pass mail/smtp_url`
set smtp_pass = `pass mail/login.mailbox.org | head -n 1`

set folder = "imaps://imap.mailbox.org:993"
set spoolfile = "+INBOX"
set postponed = "+Drafts"   # drafts
set trash = "+Trash"        # trash

# To store a copy of outgoing messages in the folder they were composed in
folder-hook . 'set record=^'
# set record = "+Sent"        # outgoing messages (classic send folder instead
#                               use above)

mailboxes `pass mail/mailboxes`
